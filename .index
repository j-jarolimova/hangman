import random


# Word list (add more)
words = ["artist", "bicycle", "castle", "camera", "desert", "dragon", "engine",
"family", "garden", "hammer", "island", "jungle", "laptop", "magnet", "market",
"monkey", "ocean", "palace", "planet", "prison", "rabbit", "rocket", "school",
"temple", "ticket", "window", "yellow", "zombie", "basket", "button", "coffee",
"diamond", "factory", "fortune", "gateway", "harvest", "kitten", "library",
"mirror", "needle", "officer", "pancake", "penguin", "picture", "printer",
"problem", "recover", "regular", "science", "secretary", "special", "stadium",
"station", "teacher", "traffic", "treasure", "tunnel", "uniform", "victory",
"village", "weather", "writer", "balloon", "blanket", "cabinet", "college",
"garlic", "helmet", "journey", "kitchen", "lantern", "message", "network",
"package", "patient", "quality", "railway", "receive", "request", "sandwich",
"satisfy", "strength", "surprise", "theater", "thunder", "vacation",
"visitor", "warrior", "western", "wizard", "agency", "capture"]

# Choose a random word
word = random.choice(words)
guessed_letters = []
wrong_guesses = 0
max_wrong = 6

# Hangman stages
hangman_pics = [
    """
     ------
     |    |
          |
          |
          |
          |
    =========
    """,
    """
     ------
     |    |
     O    |
          |
          |
          |
    =========
    """,
    """
     ------
     |    |
     O    |
     |    |
          |
          |
    =========
    """,
    """
     ------
     |    |
     O    |
    /|    |
          |
          |
    =========
    """,
    """
     ------
     |    |
     O    |
    /|\\   |
          |
          |
    =========
    """,
    """
     ------
     |    |
     O    |
    /|\\   |
    /     |
          |
    =========
    """,
    """
     ------
     |    |
     O    |
    /|\\   |
    / \\   |
          |
    =========
    """
]

# Main game loop 
while True:
    # Display current hangman and word
    print(hangman_pics[wrong_guesses])
    display_word = ""
    for letter in word:
        if letter in guessed_letters:
            display_word += letter + " "
        else:
            display_word += "_ "
    print("Word:", display_word)
    print()

    # Check for win
    if all(letter in guessed_letters for letter in word):
        print("You guessed the word! You win!")
        break

    # Check for loss
    if wrong_guesses == max_wrong:
        print("You ran out of guesses! The word was:", word)
        break

    # Get player guess
    guess = input("Guess a letter: ").lower()

    if len(guess) != 1 or not guess.isalpha():
        print("Please enter a single letter.")
        continue

    if guess in guessed_letters:
        print("You already guessed that letter.")
        continue

    guessed_letters.append(guess)

    # Check guess
    if guess in word:
        print("Good guess!")
    else:
        print("Wrong guess!")
        wrong_guesses += 1

